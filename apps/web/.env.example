# Server-side origin of the DataCourt API (FastAPI). Browser requests go to /api/* on this app
# and are proxied here, so cookies stay first-party. Not needed on Vercel, where the project's
# vercel.json routes /api/* to the API service of the same deployment.
API_ORIGIN=http://127.0.0.1:8000
# Public URLs (used for metadata / links). No secrets belong in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/ariful-arif-232/datacourt-ai
