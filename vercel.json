{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs"
    },
    "api": {
      "root": "services/api/",
      "framework": "fastapi",
      "entrypoint": "datacourt.main:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
