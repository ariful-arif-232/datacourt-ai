# DataCourt API configuration. Copy to .env for local development; never commit real values.

ENVIRONMENT=development                 # development | test | production
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/datacourt

# Secrets: in production both must be random strings of at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
SIGNED_URL_SECRET=

# Browser-facing URLs
PUBLIC_APP_URL=http://localhost:3000     # the Next.js app (used for CSRF origin checks)
PUBLIC_API_URL=http://localhost:8000     # used to build local signed storage URLs
ALLOWED_ORIGINS=http://localhost:3000    # comma-separated
COOKIE_SECURE=false                      # must be true in production (HTTPS)
SESSION_TTL_HOURS=336

# Object storage: "local" (filesystem, development) or "s3" (Backblaze B2 or any S3-compatible API).
# Backblaze B2: S3_ENDPOINT_URL=https://s3.<region>.backblazeb2.com and S3_REGION=<region>
# (shown on the bucket page), with a bucket-scoped application key (keyID / applicationKey).
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./.data/objects
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=path                 # path | virtual

# Limits
MAX_UPLOAD_BYTES=2147483648
MAX_EXTRACTED_BYTES=8589934592
MAX_FILES_PER_ARCHIVE=200000

# Embeddings: dc-descriptor-v1 (CPU, default) or dinov2-small (needs the "deep" extra)
EMBEDDING_BACKEND=dc-descriptor-v1
DINOV2_REVISION=main

# Optional: Gemini for plain-language explanations only (never scores or verdicts)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Execution: how queued jobs get a worker.
#   embedded       - worker thread in the API process (local development; set RUN_EMBEDDED_WORKER=true)
#   github_actions - the API dispatches the "DataCourt worker" workflow (production on Vercel)
#   external       - a separately running `datacourt-worker` polls the queue (dedicated / GPU worker)
EXECUTION_BACKEND=embedded
RUN_EMBEDDED_WORKER=true
# github_actions only: fine-grained token for this repository with "Actions: Read and write".
DATACOURT_GITHUB_TOKEN=
DATACOURT_GITHUB_REPO=                   # owner/repository
DATACOURT_GITHUB_REF=                    # branch with the workflow; defaults to the deployed branch
WORKER_MAX_PARALLEL=2                    # concurrent worker runs (GitHub Actions concurrency slots)

# Worker processes (GitHub Actions sets these in the workflow)
DATACOURT_ROLE=api                       # api | worker
PUBLIC_LOGS=false                        # true when logs are public: ids, types and timings only

# Demo workspace
DEMO_ENABLED=true
SEED_DEMO_ON_START=false                 # embedded backend only; otherwise run the worker task "seed-demo"
